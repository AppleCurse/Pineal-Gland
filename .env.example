# ===========================================================================
# DijitalVarlik — Ortam Degiskenleri Sablonu
# Gercek degerlerinizi kopyalayarak .env olarak kaydedin
# ===========================================================================

# OpenRouter API anahtari (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-...

# LiteLLM gateway master key
LITELLM_MASTER_KEY=your_master_key_here

# Session store sifresi (32 byte hex, ornek: openssl rand -hex 32)
SESSION_STORE_KEY=32_byte_random_hex_key_here

# DeepSeek API (deer-flow icin)
DEEPSEEK_API_KEY=sk-...

# Telegram (Opsiyonel — Cockpit kullaniliyorsa bos birakilabilir)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cockpit adresi (agent_core handover icin)
COCKPIT_URL=http://localhost:5050
