# ---- Agent-Zero (ana orkestratör) ----
# agent-zero/.env içindeki MCP_SERVER_TOKEN değerini buraya koy
AGENT_ZERO_URL=http://localhost:5000
AGENT_ZERO_API_KEY=

# ---- Deer-Flow (derin araştırma / uzun bağlam) ----
# Deer-Flow v2 gateway varsayılan portu 8001'dir (backend/.env GATEWAY_PORT).
# Gateway'e programatik erişim için DEER_FLOW_AUTH_DISABLED=1 ile başlat (bkz. DEPLOYMENT.md).
DEERFLOW_URL=http://localhost:8001
DEERFLOW_ASSISTANT_ID=

# ---- UI-TARS / Agent TARS (piksel tabanlı görsel ajan) ----
# OpenAI-uyumlu UI-TARS VLM endpoint'i:
#   vllm serve ByteDance/UI-TARS-1.5-7B --chat-template <ui_tars.jinja>
UITARS_REMOTE_ENDPOINT=
UITARS_MODEL=ui-tars-1.5

# ---- ElizaOS (persona + RAG hafızası) ----
ELIZA_URL=http://localhost:3000
ELIZA_AGENT_ID=agent
ELIZA_TOKEN=

# ---- Oturum deposu (Postiz mantığı: şifreli) ----
# Üret:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_STORE_PATH=./data/sessions.json
SESSION_STORE_KEY=

# ---- Genel ----
HTTP_TIMEOUT=120
MAX_RETRIES=3
LOG_DIR=./logs
